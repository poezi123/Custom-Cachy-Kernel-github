#!/usr/bin/env bash
# Nagelt die amdgpu-Karte als primaeres DRM-Geraet fuer Hyprland fest.
# Laeuft bei jedem Boot vor greetd (gpu-primary.service).
set -euo pipefail

find_card() {
  local c card drv
  for c in /dev/dri/by-path/pci-*-card; do
    [ -e "$c" ] || continue
    card="$(basename "$(readlink -f "$c")")"
    drv="$(basename "$(readlink -f "/sys/class/drm/$card/device/driver" 2>/dev/null)" 2>/dev/null || true)"
    # aquamarine kann nur den echten Node oeffnen, nicht den by-path-Symlink
    [ "$drv" = amdgpu ] && { echo "/dev/dri/$card"; return 0; }
  done
  return 1
}

CARD="$(find_card || true)"

if [ "${1:-}" != "--write" ]; then
  [ -n "$CARD" ] || { echo "keine amdgpu-Karte" >&2; exit 1; }
  echo "$CARD"; exit 0
fi

CONF=/etc/environment.d/94-gpu-primary.conf
[ -n "$CARD" ] || { rm -f "$CONF"; exit 0; }

printf 'AQ_DRM_DEVICES=%s\n' "$CARD" > "$CONF"

DROPIN=/run/systemd/system/greetd.service.d
mkdir -p "$DROPIN"
printf '[Service]\nEnvironment=AQ_DRM_DEVICES=%s\n' "$CARD" > "$DROPIN/50-gpu-primary.conf"
systemctl daemon-reload

# uwsm baut Hyprlands Umgebung neu auf und verwirft obiges - hier greift es
patch_uwsm() {
  local f="$1" owner
  [ -f "$f" ] || return 0
  owner="$(stat -c '%u:%g' "$f")"
  if grep -q '^export AQ_DRM_DEVICES=' "$f"; then
    sed -i "s|^export AQ_DRM_DEVICES=.*|export AQ_DRM_DEVICES=$CARD|" "$f"
  else
    printf 'export AQ_DRM_DEVICES=%s\n' "$CARD" >> "$f"
  fi
  chown "$owner" "$f"
}
patch_uwsm /etc/skel/.config/uwsm/env-hyprland
for h in /home/*/.config/uwsm/env-hyprland; do patch_uwsm "$h"; done
