#!/bin/bash
# Startet Calamares im OFFLINE-Modus.
#
# Offline heisst hier: der Installer entpackt airootfs.sfs 1:1 auf die Platte.
# Das installierte System ist damit exakt dieses Live-System - inklusive
# linux-leon, Hyprland, dem Security-Stack und allen Anpassungen.
# Der Online-Modus wuerde stattdessen eine Desktop-Auswahl zeigen und die
# Pakete frisch aus dem Netz ziehen - dabei ginge unser Setup verloren.
set -euo pipefail
mode="offline"
log="/home/liveuser/cachy-install.log"

# Ist der Log-Pfad nicht beschreibbar - etwa weil ein frueherer Lauf als root
# eine root-eigene Datei hinterlassen hat -, bricht "set -e" an der ersten
# fehlgeschlagenen Umleitung ab, und zwar ohne jede Ausgabe: der Installer
# scheint einfach nichts zu tun. Lieber woanders hin loggen als daran sterben.
if ! : >> "$log" 2>/dev/null; then
  log="$(mktemp -t cachy-install-XXXXXX.log)"
  echo "Hinweis: /home/liveuser/cachy-install.log ist nicht beschreibbar."
  echo "         Log geht stattdessen nach $log"
fi

[ -d /sys/firmware/efi ] && SYSTEM="UEFI" || SYSTEM="BIOS/MBR"
inxi -F > "$log" 2>/dev/null || true
{
  echo "########## Start (UTC): $(date -u '+%x %X')"
  echo "########## ISO: $(cat /etc/version-tag 2>/dev/null || echo unbekannt)"
  echo "########## Modus: $mode   System: $SYSTEM"
} >> "$log"

# Unsere angepassten Calamares-Dateien erst hier platzieren, nicht schon im
# airootfs-Overlay: mkarchiso kopiert das Overlay VOR der Paketinstallation,
# und cachyos-calamares-next fuehrt diese beiden Pfade nicht in seinem
# backup-Array -> pacman bricht mit "exists in filesystem" ab.
SRC=/usr/local/share/cachy-install
sudo install -Dm644 "$SRC/settings_offline.conf" /usr/share/calamares/settings_offline.conf
sudo install -Dm644 "$SRC/unpackfs.conf"         /etc/calamares/modules/unpackfs.conf
# Bootloader fest auf grub - der Paket-Default waehlt limine, das hier nicht
# installiert ist. Ohne das bleibt das installierte System ohne Bootloader.
sudo install -Dm644 "$SRC/bootloader.conf"       /etc/calamares/modules/bootloader.conf

sudo cp "/usr/share/calamares/settings_${mode}.conf" /etc/calamares/settings.conf
exec pkexec-wrapper calamares -D6 >> "$log" 2>&1
