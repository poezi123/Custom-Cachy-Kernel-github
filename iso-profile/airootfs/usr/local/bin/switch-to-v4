#!/usr/bin/env bash
# Schaltet die CachyOS-Repos von x86-64-v3 auf x86-64-v4 (AVX-512) um.
#
# Warum das nicht schon in der ISO steckt: die ISO wurde auf einem Zen-2-Rechner
# gebaut, der kein AVX-512 kann - mkarchiso fuehrt beim Bauen Binaries aus dem
# entstehenden System aus und waere mit v4-Paketen abgestuerzt (SIGILL).
# Der 8845HS kann v4. Ein v4-Userspace bringt bei Compile-Workloads real etwas.
set -euo pipefail
[ "$(id -u)" -eq 0 ] || { echo "Bitte mit sudo ausfuehren."; exit 1; }

echo ">>> Pruefe CPU-Unterstuetzung fuer x86-64-v4 ..."
MISSING=""
for f in avx512f avx512bw avx512cd avx512dq avx512vl; do
  grep -qw "$f" /proc/cpuinfo || MISSING="$MISSING $f"
done
if [ -n "$MISSING" ]; then
  echo "ABBRUCH: Diese CPU kann kein x86-64-v4. Fehlend:$MISSING"
  echo "Das System bleibt korrekt auf v3 - kein Handlungsbedarf."
  exit 1
fi
echo "    ok - AVX-512 vollstaendig vorhanden."

pacman -S --needed --noconfirm cachyos-v4-mirrorlist

cp -a /etc/pacman.conf "/etc/pacman.conf.bak.$(date +%F-%H%M%S)"
echo ">>> Backup: /etc/pacman.conf.bak.*"

sed -i -e 's/^\[cachyos-v3\]/[cachyos-v4]/' \
       -e 's/^\[cachyos-core-v3\]/[cachyos-core-v4]/' \
       -e 's/^\[cachyos-extra-v3\]/[cachyos-extra-v4]/' \
       -e 's|cachyos-v3-mirrorlist|cachyos-v4-mirrorlist|g' /etc/pacman.conf
grep -q 'x86_64_v4' /etc/pacman.conf || \
  sed -i 's/^Architecture *=.*/Architecture = x86_64 x86_64_v3 x86_64_v4/' /etc/pacman.conf

# Das lokale ISO-Repo existiert auf dem installierten System nicht mehr.
sed -i '/^\[leon-local\]/,+2d' /etc/pacman.conf

echo ">>> Repos jetzt:"; grep -E '^\[' /etc/pacman.conf
echo
echo ">>> Vollstaendiges Neuaufloesen aller Pakete gegen v4 (-Syyuu) ..."
pacman -Syyuu
echo
echo "Fertig. linux-leon ist davon nicht betroffen - der Kernel ist bereits"
echo "auf znver4 gebaut und wird nicht aus einem Repo ersetzt."
