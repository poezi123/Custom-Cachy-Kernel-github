#!/usr/bin/env bash
# Traegt kb_layout in Hyprlands inputs.lua nach (Default: de).
set -euo pipefail
LAYOUT="${1:-de}"

patch_file() {
  local f="$1" owner
  [ -f "$f" ] || return 0
  grep -q kb_layout "$f" && return 0
  owner="$(stat -c '%u:%g' "$f")"
  sed -i "0,/accel_profile *= *\"[^\"]*\",/s//&\n        kb_layout = \"$LAYOUT\",/" "$f"
  grep -q kb_layout "$f" || sed -i "0,/input *= *{/s//&\n        kb_layout = \"$LAYOUT\",/" "$f"
  chown "$owner" "$f"
}

patch_file /etc/skel/.config/hypr/config/inputs.lua
for h in /home/*/.config/hypr/config/inputs.lua; do patch_file "$h"; done
