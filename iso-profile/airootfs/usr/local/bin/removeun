#!/bin/bash
# Angepasst gegenueber dem CachyOS-Original.
#
# Das Original entfernte nach der Installation u.a. tcpdump, cmake,
# extra-cmake-modules, squashfs-tools, gparted, memtest86+ und
# arch-install-scripts. Das sind Pakete aus dem gewuenschten Security-,
# Dev- und Recovery-Stack -> hier bewusst BEHALTEN.
#
# Entfernt werden nur echte Live-ISO-Artefakte, die auf einem installierten
# System keinen Zweck mehr haben.

_remove_pacman_package() { pacman -Rsnc "$1" --noconfirm || true; }

_clean_files() {
  local f
  for f in /usr/local/bin/choose-mirror \
           /usr/local/bin/prepare-live-desktop.sh \
           /usr/local/bin/removeun-online \
           /usr/local/share/livecd-sound; do
    rm -rf "$f" || true
  done
}

# NUR Live-/Installer-Artefakte.
_packages_to_remove=(
  cachyos-calamares-next
  cachyos-calamares-grub
  cachyos-calamares-systemd
  cachyos-calamares-refind
  cachyos-calamares
  cachyos-calamares-config
  cachyos-cli-installer-new
  mkinitcpio-archiso
  clonezilla
  grsync
  elinks
  gpart
)

# BEWUSST BEHALTEN (Original entfernte diese):
#   tcpdump             - Security-Stack
#   cmake, extra-cmake-modules, ninja - Dev-Toolchain
#   squashfs-tools      - um spaeter selbst ISOs zu bauen
#   gparted             - Partitionierung im Alltag
#   arch-install-scripts- arch-chroot fuer Recovery
#   memtest86+, edk2-shell, syslinux - Boot-/Diagnose-Faehigkeit
#   boost-libs, yaml-cpp, doxygen, expect - harmlose Deps

# Calamares' Offline-Sequenz ruft NACH diesem Skript noch drei Skripte auf, die
# dem Calamares-Paket gehoeren, das wir hier gerade entfernen:
#   /etc/calamares/scripts/{dmcheck,shell-setup,bootloader-post-setup}
# (Hauptschritt "shellprocess", siehe shellprocess.conf). "pacman -Rsnc" loescht
# sie mit, und der naechste Schritt stirbt dann mit Exit 127 -> die ganze
# Installation bricht ab ("Externes Programm mit Fehlern beendet").
#
# Upstream entgeht dem nur im pacstrap-Modus: dort legt "postInstallFiles"
# (pacstrap.conf) diese Skripte vorher als paketunabhaengige Kopien ab, die die
# Paketentfernung ueberleben. Der Offline-Modus (unpackfs) kennt diesen Schritt
# nicht. Also machen wir es hier selbst: wegsichern, Paket entfernen,
# als paketfreie Dateien zuruecklegen. Calamares raeumt sie danach selbst weg.
_detach_needed_scripts() {
  local d=/etc/calamares/scripts s b
  _stash="$(mktemp -d)"
  for s in dmcheck shell-setup bootloader-post-setup; do
    [ -f "$d/$s" ] && cp -a "$d/$s" "$_stash/$s"
  done
}
_reattach_needed_scripts() {
  local d=/etc/calamares/scripts b
  mkdir -p "$d"
  for b in dmcheck shell-setup bootloader-post-setup; do
    [ -f "$_stash/$b" ] && cp -a "$_stash/$b" "$d/$b"
  done
  rm -rf "$_stash"
}

_clean_files
_detach_needed_scripts
for p in "${_packages_to_remove[@]}"; do
  pacman -Qi "$p" &>/dev/null && _remove_pacman_package "$p"
done
_reattach_needed_scripts
exit 0
