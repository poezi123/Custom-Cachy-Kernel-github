[Unit]
Description=Primaeres DRM-Geraet (Display-GPU) festnageln
Documentation=man:gpu-primary-card
Before=greetd.service display-manager.service graphical.target
After=systemd-udev-settle.service
Wants=systemd-udev-settle.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/gpu-primary-card --write

[Install]
WantedBy=graphical.target
