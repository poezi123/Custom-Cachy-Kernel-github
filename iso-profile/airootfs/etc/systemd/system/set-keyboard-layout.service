[Unit]
Description=Deutsches Tastaturlayout in Hyprlands Konfiguration eintragen
# Muss vor dem Compositor laufen - greetd startet den Greeter, der das Layout
# schon braucht.
Before=greetd.service display-manager.service graphical.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/set-keyboard-layout de

[Install]
WantedBy=graphical.target
